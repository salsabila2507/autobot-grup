# Example environment file.
#
# Copy to .env and fill in. Never commit .env -- it is in .gitignore.
# Secrets live outside the repository; this file only points at them.

# Telegram app credentials from https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=CHANGE_ME

# Paths to the secrets the services read. chmod 600 each file.
HOTTI_QUEUE_BOT_TOKEN_FILE=/home/ubuntu/.secrets/bot_token.txt
HOTTI_USERBOT_SESSION_FILE=/home/ubuntu/.secrets/userbot_session.txt
HOTTI_X_COOKIES_DIR=/home/ubuntu/.secrets/x_cookies
HOTTI_X_COOKIE_HEADER=/home/ubuntu/.secrets/x_cookies/header.txt

# Optional: where the SQLite database and session live
HOTTI_DB=/home/ubuntu/bot/data/engine.sqlite

# Optional: browser binaries for the X reply reader
PLAYWRIGHT_BROWSERS_PATH=/home/ubuntu/bot/.playwright
